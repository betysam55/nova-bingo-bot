# Nova Bingo Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Mini App URL (HTTPS URL where the webapp is hosted)
# Required for the "Open Nova Bingo" button in /start and /play
WEBAPP_URL=

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
